PROJECT_NAME="一言SQL"

# Backend security. Generate fresh values for every non-development environment.
SECRET_KEY=replace-with-a-random-secret
DEFAULT_PWD=replace-with-an-initial-admin-password
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLBot metadata database (PostgreSQL with pgvector).
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sqlbot_dev
POSTGRES_USER=sqlbot_dev
POSTGRES_PASSWORD=replace-with-the-local-database-password

# Keep first boot independent from the local embedding model. Enable both after
# the complete model snapshot is available under LOCAL_MODEL_PATH.
EMBEDDING_ENABLED=false
TABLE_EMBEDDING_ENABLED=false
LOCAL_MODEL_PATH=D:/opt/sqlbot/models

# Adaptive rollout switches. Turn off answer-time retrieval independently from
# feedback capture and shared-knowledge approval; restart the backend after a change.
ADAPTIVE_METRICS_IN_ANSWERS=true
ADAPTIVE_MEMORY_IN_ANSWERS=true
ADAPTIVE_FEEDBACK_WRITES_ENABLED=true
ADAPTIVE_SHARED_LEARNING_ACTIVATION_ENABLED=true

# Windows development paths.
BASE_DIR=D:/opt/sqlbot
UPLOAD_DIR=D:/opt/sqlbot/data/file
EXCEL_PATH=D:/opt/sqlbot/data/excel
MCP_IMAGE_PATH=D:/opt/sqlbot/images
LOG_DIR=D:/opt/sqlbot/logs
SERVER_IMAGE_HOST=http://127.0.0.1:8001/images/

CACHE_TYPE=memory
LOG_LEVEL=DEBUG
SQL_DEBUG=false
SQLBOT_DOC_ENABLED=true

# Independent test environment only. Disabled by default; three distinct secrets,
# each at least 32 characters. Never copy production settings for this experiment.
GRAPH_EXPERIMENT_ENABLED=false
GRAPH_TEST_USERS=
GRAPH_TEST_WORKSPACES=
GRAPH_MODEL_ID=0
GRAPH_SERVICE_URL=http://127.0.0.1:8030
BACKEND_TO_GRAPH_TOKEN=
GRAPH_TO_GATEWAY_TOKEN=
GRAPH_DELEGATION_SECRET=
